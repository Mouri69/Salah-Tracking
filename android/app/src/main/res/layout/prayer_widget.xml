<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="horizontal"
    android:padding="4dp"
    android:gravity="center_vertical">

    <!-- Prayers Row - All 5 in one horizontal row, compact -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="5">

        <!-- Fajr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/prayer_card_background_gray"
            android:orientation="vertical"
            android:padding="3dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/prayer_0">

            <TextView
                android:id="@+id/prayer_0_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fajr"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/prayer_0_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5:00 AM"
                android:textSize="7sp"
                android:textColor="#666666"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/prayer_0_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Prayed"
                android:textSize="6sp"
                android:textColor="#FFFFFF"
                android:background="#9E9E9E"
                android:padding="1dp"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/prayer_card_background_gray"
            android:orientation="vertical"
            android:padding="3dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/prayer_1">

            <TextView
                android:id="@+id/prayer_1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dhuhr"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/prayer_1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00 PM"
                android:textSize="7sp"
                android:textColor="#666666"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/prayer_1_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Prayed"
                android:textSize="6sp"
                android:textColor="#FFFFFF"
                android:background="#9E9E9E"
                android:padding="1dp"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/prayer_card_background_gray"
            android:orientation="vertical"
            android:padding="3dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/prayer_2">

            <TextView
                android:id="@+id/prayer_2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asr"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/prayer_2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3:00 PM"
                android:textSize="7sp"
                android:textColor="#666666"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/prayer_2_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Prayed"
                android:textSize="6sp"
                android:textColor="#FFFFFF"
                android:background="#9E9E9E"
                android:padding="1dp"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/prayer_card_background_gray"
            android:orientation="vertical"
            android:padding="3dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/prayer_3">

            <TextView
                android:id="@+id/prayer_3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maghrib"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/prayer_3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6:00 PM"
                android:textSize="7sp"
                android:textColor="#666666"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/prayer_3_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Prayed"
                android:textSize="6sp"
                android:textColor="#FFFFFF"
                android:background="#9E9E9E"
                android:padding="1dp"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:background="@drawable/prayer_card_background_gray"
            android:orientation="vertical"
            android:padding="3dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/prayer_4">

            <TextView
                android:id="@+id/prayer_4_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Isha"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/prayer_4_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7:30 PM"
                android:textSize="7sp"
                android:textColor="#666666"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/prayer_4_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Prayed"
                android:textSize="6sp"
                android:textColor="#FFFFFF"
                android:background="#9E9E9E"
                android:padding="1dp"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

    <!-- Counter on the right -->
    <TextView
        android:id="@+id/widget_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0/5"
        android:textSize="12sp"
        android:textColor="#2196F3"
        android:textStyle="bold"
        android:layout_marginStart="4dp" />

</LinearLayout>
